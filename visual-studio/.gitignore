node_modules/
dist/
.cache/
exports/
test-results/

# Required release sources: override the parent repository's generic JSON/media ignores.
!package.json
!package-lock.json
!tsconfig.json
!src/**/*.json
!external/**/*.json
!public/**/*.png
!public/**/*.jpg
!public/**/*.jpeg
public/fredtalk/*.ttf

# Round-1 render evidence and LW-owned placeholder clips must ship with the repo.
!external/fredtalk/batch/evidence/**/*.mp4
!public/fredtalk/media/*.mp4

# Reproducible adapter profiles are source, not build output.
!tools/fredtalk/profiles/*.json
!external/fredtalk/batch/round1.json
!external/fredtalk/batch/reviews-round1.json
!external/fredtalk/batch/batches/*.json

# Later batch videos are separate acceptance artifacts, not permanent repo content.
external/fredtalk/batch/runs/
