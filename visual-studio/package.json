{
  "name": "lw-visual-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "npm run build && npm run test:unit && npm run test:api",
    "render": "node render.mjs",
    "sfx": "node scripts/make-sfx.mjs",
    "direct": "node scripts/direct.mjs",
    "lint:project": "node scripts/lint-project.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:api:cases": "node --test tests/api/*.test.mjs",
    "test:media": "node scripts/test-media.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.4.0",
    "@remotion/bundler": "4.0.545",
    "@remotion/player": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@remotion/three": "4.0.545",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.545",
    "three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
